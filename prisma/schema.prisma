// Constructeasy — Prisma Schema
// Batch 0 (Core Infrastructure): connection + generator only.
//
// Per the Phase 3 Backend Implementation Plan, Section 6:
// "One Prisma schema file, incrementally extended per batch — not one
// giant upfront migration." Models are added starting Batch 1 (Locations
// & Lookups) in the exact order of the Sign-Off Document's migration order
// (Section 6.4).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Batch 1: Locations & Lookups ---
// Order matches Sign-Off Section 6.4 migration order exactly.

model Country {
  id        String   @id @default(uuid())
  name      String
  isoCode   String   @unique @map("iso_code")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  states State[]

  @@map("countries")
}

model Locale {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("locales")
}

model Role {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userRoles UserRole[]

  @@map("roles")
}

// --- Batch 2: Users & Auth ---

model User {
  id          String    @id @default(uuid())
  clerkUserId String    @unique @map("clerk_user_id")
  email       String?   @unique
  phone       String?   @unique
  localeId    String?   @map("locale_id")
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  locale    Locale?    @relation(fields: [localeId], references: [id])
  userRoles UserRole[]
  adminUser AdminUser?

  @@index([localeId])
  @@map("users")
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model AdminUser {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("admin_users")
}

enum WebhookProvider {
  clerk
}

model WebhookEvent {
  id              String          @id @default(uuid())
  provider        WebhookProvider
  eventId         String          @unique @map("event_id")
  eventType       String          @map("event_type")
  payload         Json
  processedAt     DateTime?       @map("processed_at")
  processingError String?         @map("processing_error")
  receivedAt      DateTime        @default(now()) @map("received_at")

  @@index([provider, eventId])
  @@map("webhook_events")
}

model SubscriptionPlan {
  id              String   @id @default(uuid())
  name            String
  pricePaise      Int      @map("price_paise")
  billingInterval String   @map("billing_interval")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("subscription_plans")
}

model ProfessionalCategory {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("professional_categories")
}

model State {
  id        String   @id @default(uuid())
  countryId String   @map("country_id")
  name      String
  code      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  country Country @relation(fields: [countryId], references: [id])
  cities  City[]

  @@map("states")
}

model City {
  id         String    @id @default(uuid())
  stateId    String    @map("state_id")
  name       String
  slug       String    @unique
  isActive   Boolean   @default(false) @map("is_active")
  launchedAt DateTime? @map("launched_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  state      State       @relation(fields: [stateId], references: [id])
  localities Locality[]

  @@map("cities")
}

model Locality {
  id        String   @id @default(uuid())
  cityId    String   @map("city_id")
  name      String
  slug      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  city City @relation(fields: [cityId], references: [id])

  @@unique([cityId, slug])
  @@map("localities")
}
