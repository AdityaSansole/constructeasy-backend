// Constructeasy — Prisma Schema
// Batch 0 (Core Infrastructure): connection + generator only.
//
// Per the Phase 3 Backend Implementation Plan, Section 6:
// "One Prisma schema file, incrementally extended per batch — not one
// giant upfront migration." Models are added starting Batch 1 (Locations
// & Lookups) in the exact order of the Sign-Off Document's migration order
// (Section 6.4).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Batch 1: Locations & Lookups ---
// Order matches Sign-Off Section 6.4 migration order exactly.

model Country {
  id        String   @id @default(uuid())
  name      String
  isoCode   String   @unique @map("iso_code")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  states State[]

  @@map("countries")
}

model Locale {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("locales")
}

model Role {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userRoles UserRole[]

  @@map("roles")
}

// --- Batch 2: Users & Auth ---

model User {
  id          String    @id @default(uuid())
  clerkUserId String    @unique @map("clerk_user_id")
  email       String?   @unique
  phone       String?   @unique
  localeId    String?   @map("locale_id")
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  locale              Locale?              @relation(fields: [localeId], references: [id])
  userRoles           UserRole[]
  adminUser           AdminUser?
  homeownerProfile    HomeownerProfile?
  professionalProfile ProfessionalProfile?
  verificationHistories VerificationHistory[]
  contactHistories    ContactHistory[]

  @@index([localeId])
  @@map("users")
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model AdminUser {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user                User                 @relation(fields: [userId], references: [id])
  verificationReviews VerificationRecord[]

  @@map("admin_users")
}

enum WebhookProvider {
  clerk
}

model WebhookEvent {
  id              String          @id @default(uuid())
  provider        WebhookProvider
  eventId         String          @unique @map("event_id")
  eventType       String          @map("event_type")
  payload         Json
  processedAt     DateTime?       @map("processed_at")
  processingError String?         @map("processing_error")
  receivedAt      DateTime        @default(now()) @map("received_at")

  @@index([provider, eventId])
  @@map("webhook_events")
}

model SubscriptionPlan {
  id              String   @id @default(uuid())
  name            String
  pricePaise      Int      @map("price_paise")
  billingInterval String   @map("billing_interval")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("subscription_plans")
}

model ProfessionalCategory {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  categoryMap ProfessionalCategoryMap[]

  @@map("professional_categories")
}

model State {
  id        String   @id @default(uuid())
  countryId String   @map("country_id")
  name      String
  code      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  country Country @relation(fields: [countryId], references: [id])
  cities  City[]

  @@map("states")
}

model City {
  id         String    @id @default(uuid())
  stateId    String    @map("state_id")
  name       String
  slug       String    @unique
  isActive   Boolean   @default(false) @map("is_active")
  launchedAt DateTime? @map("launched_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  state      State      @relation(fields: [stateId], references: [id])
  localities Locality[]

  @@map("cities")
}

model Locality {
  id        String   @id @default(uuid())
  cityId    String   @map("city_id")
  name      String
  slug      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  city                 City                  @relation(fields: [cityId], references: [id])
  homeownerProfiles    HomeownerProfile[]
  primaryProfessionals ProfessionalProfile[] @relation("PrimaryLocality")
  serviceAreas         ServiceArea[]
  portfolioProjects    PortfolioProject[]
  contacts             Contact[]

  @@unique([cityId, slug])
  @@map("localities")
}

// --- Batch 3: Profiles ---

enum VerificationLevel {
  unverified
  level_1
  level_2
}

enum CoverageType {
  locality
  radius
}

model HomeownerProfile {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  fullName   String   @map("full_name")
  localityId String?  @map("locality_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  locality Locality? @relation(fields: [localityId], references: [id], onDelete: SetNull)
  contacts Contact[]

  @@index([localityId])
  @@map("homeowner_profiles")
}

model ProfessionalProfile {
  id                String            @id @default(uuid())
  userId            String            @unique @map("user_id")
  businessName      String            @map("business_name")
  slug              String            @unique
  bio               String?
  yearsExperience   Int?              @map("years_experience")
  primaryLocalityId String            @map("primary_locality_id")

  // Trigger-owned columns — exist now, written only by future DB triggers
  // (Batch 4 verification-state trigger, Batch 8 rating-aggregate trigger).
  // Never set by Batch 3 application code.
  verificationLevel VerificationLevel @default(unverified) @map("verification_level")
  verifiedAt        DateTime?         @map("verified_at")
  isPublished       Boolean           @default(false) @map("is_published")
  averageRating     Decimal           @default(0) @db.Decimal(3, 2) @map("average_rating")
  reviewCount       Int               @default(0) @map("review_count")
  projectCount      Int               @default(0) @map("project_count")

  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user                User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  primaryLocality     Locality                  @relation("PrimaryLocality", fields: [primaryLocalityId], references: [id], onDelete: Restrict)
  serviceAreas        ServiceArea[]
  categoryMap         ProfessionalCategoryMap[]
  verificationRecords VerificationRecord[]
  portfolioProjects   PortfolioProject[]
  contacts            Contact[]

  @@index([isPublished, primaryLocalityId])
  @@index([isPublished, averageRating(sort: Desc)])
  @@map("professional_profiles")
}

model ServiceArea {
  id             String       @id @default(uuid())
  professionalId String       @map("professional_id")
  localityId     String       @map("locality_id")
  coverageType   CoverageType @default(locality) @map("coverage_type")
  radiusKm       Decimal?     @db.Decimal(5, 2) @map("radius_km")
  createdAt      DateTime     @default(now()) @map("created_at")

  // DB-level CHECK: radius_km > 0 WHERE coverage_type = 'radius'
  // Hand-authored in migration SQL (Prisma cannot express conditional CHECKs).
  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  locality     Locality            @relation(fields: [localityId], references: [id], onDelete: Restrict)

  @@unique([professionalId, localityId])
  @@index([localityId, professionalId])
  @@map("service_areas")
}

model ProfessionalCategoryMap {
  id             String   @id @default(uuid())
  professionalId String   @map("professional_id")
  categoryId     String   @map("category_id")
  createdAt      DateTime @default(now()) @map("created_at")

  professional ProfessionalProfile  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  category     ProfessionalCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([professionalId, categoryId])
  @@index([categoryId])
  @@map("professional_category_map")
}

// --- Batch 4: Verification & Trust ---

enum VerificationStatus {
  draft
  pending
  info_requested
  approved
  rejected
  suspended
}

enum DocumentType {
  identity_proof
  gstin_certificate
  council_of_architecture_reg
  engineering_council_reg
  degree_certificate
  trade_license
  incorporation_certificate
}

enum DocumentStatus {
  pending
  verified
  rejected
}

model VerificationRecord {
  id             String             @id @default(uuid())
  professionalId String             @map("professional_id")
  status         VerificationStatus @default(draft)
  version        Int                @default(1)
  reviewedBy     String?            @map("reviewed_by")
  reviewerNotes  String?            @map("reviewer_notes")
  submittedAt    DateTime?          @map("submitted_at")
  reviewedAt     DateTime?          @map("reviewed_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  professional ProfessionalProfile    @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  reviewer     AdminUser?             @relation(fields: [reviewedBy], references: [id], onDelete: SetNull)
  documents    VerificationDocument[]
  history      VerificationHistory[]

  @@index([professionalId])
  @@index([status])
  @@map("verification_records")
}

model VerificationDocument {
  id                   String         @id @default(uuid())
  verificationRecordId String         @map("verification_record_id")
  documentType         DocumentType   @map("document_type")
  documentNumber       String?        @map("document_number")
  fileKey              String         @map("file_key")
  originalFilename     String         @map("original_filename")
  mimeType             String         @map("mime_type")
  fileSize             Int            @map("file_size")
  checksum             String?
  status               DocumentStatus @default(pending)
  rejectionReason      String?        @map("rejection_reason")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  verificationRecord VerificationRecord @relation(fields: [verificationRecordId], references: [id], onDelete: Cascade)

  @@unique([verificationRecordId, documentType])
  @@index([verificationRecordId])
  @@map("verification_documents")
}

model VerificationHistory {
  id                   String             @id @default(uuid())
  verificationRecordId String             @map("verification_record_id")
  fromStatus           VerificationStatus @map("from_status")
  toStatus             VerificationStatus @map("to_status")
  actorUserId          String             @map("actor_user_id")
  reason               String?
  createdAt            DateTime           @default(now()) @map("created_at")

  verificationRecord VerificationRecord @relation(fields: [verificationRecordId], references: [id], onDelete: Cascade)
  actor              User               @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([verificationRecordId])
  @@map("verification_history")
}

// --- Batch 5: Portfolio & Media Showcase ---

model PortfolioProject {
  id             String              @id @default(uuid())
  professionalId String              @map("professional_id")
  title          String
  slug           String              @unique
  description    String?             @db.Text
  projectType    String?             @map("project_type")
  completionYear Int?                @map("completion_year")
  costInr        Decimal?            @map("cost_inr") @db.Decimal(12, 2)
  localityId     String?             @map("locality_id")
  isFeatured     Boolean             @default(false) @map("is_featured")
  isPublished    Boolean             @default(true) @map("is_published")
  displayOrder   Int                 @default(0) @map("display_order")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  locality     Locality?           @relation(fields: [localityId], references: [id], onDelete: SetNull)
  media        PortfolioMedia[]
  contacts     Contact[]

  @@index([professionalId, isPublished, displayOrder])
  @@index([localityId])
  @@map("portfolio_projects")
}

model PortfolioMedia {
  id                 String           @id @default(uuid())
  portfolioProjectId String           @map("portfolio_project_id")
  fileKey            String           @map("file_key")
  originalFilename   String           @map("original_filename")
  mimeType           String           @map("mime_type")
  fileSize           Int              @map("file_size")
  width              Int?
  height             Int?
  caption            String?
  displayOrder       Int              @default(0) @map("display_order")
  isCover            Boolean          @default(false) @map("is_cover")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  project PortfolioProject @relation(fields: [portfolioProjectId], references: [id], onDelete: Cascade)

  @@index([portfolioProjectId, displayOrder])
  @@map("portfolio_media")
}

// --- Batch 7: Contacts & Lead Generation ---

enum ContactStatus {
  pending
  accepted
  declined
  canceled
  archived
}

model Contact {
  id             String        @id @default(uuid())
  homeownerId    String        @map("homeowner_id")
  professionalId String        @map("professional_id")
  projectId      String?       @map("project_id")
  localityId     String?       @map("locality_id")
  status         ContactStatus @default(pending)

  message        String        @db.Text
  phone          String?
  email          String?
  budgetInr      Decimal?      @map("budget_inr") @db.Decimal(12, 2)
  timeline       String?
  declinedReason String?       @map("declined_reason")

  respondedAt    DateTime?     @map("responded_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  homeowner    HomeownerProfile     @relation(fields: [homeownerId], references: [id], onDelete: Restrict)
  professional ProfessionalProfile  @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  project      PortfolioProject?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  locality     Locality?            @relation(fields: [localityId], references: [id], onDelete: SetNull)
  history      ContactHistory[]

  @@index([homeownerId, status])
  @@index([professionalId, status])
  @@map("contacts")
}

model ContactHistory {
  id          String         @id @default(uuid())
  contactId   String         @map("contact_id")
  fromStatus  ContactStatus? @map("from_status")
  toStatus    ContactStatus  @map("to_status")
  actorUserId String         @map("actor_user_id")
  reason      String?
  createdAt   DateTime       @default(now()) @map("created_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  actor   User    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([contactId])
  @@map("contact_history")
}


