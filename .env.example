# Constructeasy Backend — Environment Variables
# Copy to .env for local development. NEVER commit a real .env file.
# In staging/production, these are injected via AWS Secrets Manager + ECS task
# definitions (Sign-Off Section 11 / Phase 3 Plan Section 15) — not files.

NODE_ENV=development
PORT=3000

# --- Database (Prisma / RDS PostgreSQL) ---
DATABASE_URL="postgresql://user:password@localhost:5432/constructeasy?schema=public"

# --- Redis (ElastiCache locally via docker) ---
REDIS_URL="redis://localhost:6379"

# --- Clerk ---
CLERK_SECRET_KEY="sk_test_xxx"
CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_WEBHOOK_SIGNING_SECRET="whsec_xxx"

# --- AWS / S3 ---
AWS_REGION="ap-south-1"
S3_PUBLIC_BUCKET_NAME="constructeasy-dev-public"
S3_PRIVATE_BUCKET_NAME="constructeasy-dev-private"
# Local dev only — staging/production use ECS task IAM roles instead:
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# --- Sentry ---
SENTRY_DSN=""

# --- Rate limiting (baseline, per Sign-Off Section 11) ---
RATE_LIMIT_AUTHENTICATED_PER_MIN=100
RATE_LIMIT_UNAUTHENTICATED_PER_MIN=30

# --- Cache TTLs (seconds, per Sign-Off Section 8) ---
CACHE_TTL_LOOKUP_SECONDS=3600
CACHE_TTL_LIST_SECONDS=45
CACHE_TTL_DASHBOARD_SECONDS=60
